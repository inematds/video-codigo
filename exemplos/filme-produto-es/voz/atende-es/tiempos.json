 "frases": [
  {
   "id": "hook",
   "bloque": "abertura",
   "texto": "El prospecto que espera en WhatsApp se enfría.",
   "inicio": 0.0,
   "fin": 3.0
  },
  {
   "id": "dor",
   "bloque": "abertura",
   "texto": "Cada minuto sin respuesta es una venta que se va.",
   "inicio": 3.44,
   "fin": 5.9
  },
  {
   "id": "chega",
   "bloque": "agente",
   "texto": "Con atende-leads, quien responde primero es un agente.",
   "inicio": 6.63,
   "fin": 10.17
  },
  {
   "id": "faq",
   "bloque": "agente",
   "texto": "Pregunta el nombre, qué busca la persona y para cuándo.",
   "inicio": 10.61,
   "fin": 14.23
  },
  {
   "id": "nota",
   "bloque": "agente",
   "texto": "Y califica al prospecto: caliente, tibio o frío.",
   "inicio": 14.67,
   "fin": 18.05
  },
  {
   "id": "gatilho",
   "bloque": "oferta",
   "texto": "Cuando hace falta una persona, el prospecto pasa a quien lleva más tiempo libre.",
   "inicio": 18.748,
   "fin": 23.128
  },
  {
   "id": "card",
   "bloque": "oferta",
   "texto": "En Telegram llegan el nombre, el interés, los últimos mensajes y los botones.",
   "inicio": 23.568,
   "fin": 28.528
  },
  {
   "id": "dois",
   "bloque": "oferta",
   "texto": "Si nadie responde en dos minutos, pasa al siguiente.",
   "inicio": 28.968,
   "fin": 31.968
  },
  {
   "id": "assume",
   "bloque": "oferta",
   "texto": "Bruno se hace cargo y llama de inmediato.",
   "inicio": 32.408,
   "fin": 34.928
  },
  {
   "id": "painel",
   "bloque": "equipe",
   "texto": "En el grupo, un panel muestra quién está disponible, quién está atendiendo y la fila.",
   "inicio": 35.645,
   "fin": 41.305
  },
  {
   "id": "sugestao",
   "bloque": "equipe",
   "texto": "Con cada mensaje del prospecto llega una sugerencia de respuesta. Solo tocas enviar.",
   "inicio": 41.691,
   "fin": 46.711
  },
  {
   "id": "vendeu",
   "bloque": "fecho",
   "texto": "¿Vendiste? Un toque registra el valor y Bruno vuelve a la fila.",
   "inicio": 47.441,
   "fin": 51.381
  },
  {
   "id": "gestor",
   "bloque": "fecho",
   "texto": "Y el gestor lo ve todo en vivo.",
   "inicio": 51.778,
   "fin": 53.498
  },
  {
   "id": "cta",
   "bloque": "fecho",
   "texto": "Es de código abierto y funciona en tu VPS. Está todo en INEMA.CLUB.",
   "inicio": 53.938,
   "fin": 58.278
  }
 ],
